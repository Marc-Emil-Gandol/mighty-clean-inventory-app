PORT=4000
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Local dev: point at a local Postgres instance, e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mightyclean
#
# On Render: leave this unset locally, and instead let Render inject it
# automatically from the linked database (see render.yaml).
DATABASE_URL=postgresql://user:password@localhost:5432/mightyclean
